            },
            {
              "type": "h3",
              "children": [
                "Standalone Skills"
              ]
            },
            {
              "type": "p",
              "children": [
                "This path installs all three Skills together."
              ]
            },
            {
              "type": "h4",
              "children": [
                "Install"
              ]
            },
            {
              "type": "code",
              "language": "bash",
              "children": [
                "npx skills add superdurable/dex-skills --skill '*' --agent codex --global"
              ]
            },
            {
              "type": "h4",
              "children": [
                "Use"
              ]
            },
            {
              "type": "invocations",
              "style": "codex"
            },
            {
              "type": "h4",
              "children": [
                "Update"
              ]
            },
            {
              "type": "code",
              "language": "bash",
              "children": [
                "npx skills update dex-app-builder dex-sdk dex-connector-contributor --global"
              ]
            },
            {
              "type": "p",
              "children": [
                "If the installed skills CLI does not support update, rerun the installation command above."
              ]
            },
            {
              "type": "p",
              "children": [
                "Use the standalone Skill path for deterministic non-interactive invocation."
              ]
            }
          ]
        },
