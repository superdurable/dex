  "locales": {
    "en": {
      "introduction": "Choose your host, then one installation path: the Plugin or the standalone Skills.",
      "hosts": [
        {
          "id": "codex-desktop",
          "label": "Codex Desktop",
          "children": [
            {
              "type": "h3",
              "children": [
                "Plugin (recommended)"
              ]
            },
            {
              "type": "h4",
              "children": [
                "Install"
              ]
            },
            {
              "type": "p",
              "children": [
                "This path needs no separate Codex CLI installation."
              ]
            },
            {
              "type": "ol",
              "children": [
                {
                  "type": "li",
                  "children": [
                    "Open the plugin browser, open the add menu, and select Add a marketplace."
                  ]
                },
                {
                  "type": "li",
                  "children": [
                    "Use the repository below as Source, main as Git ref, and leave Sparse paths empty."
                  ]
                }
              ]
            },
            {
              "type": "code",
              "language": "text",
              "children": [
                "https://github.com/superdurable/dex-skills"
              ]
            },
            {
              "type": "ol",
              "start": 3,
              "children": [
                {
                  "type": "li",
                  "children": [
                    "Add the marketplace, open Super Durable, select Dex, and install it."
                  ]
                },
                {
                  "type": "li",
                  "children": [
                    "Open a repository or empty project, then start a new task."
                  ]
                }
              ]
            },
            {
              "type": "h4",
              "children": [
                "Use"
              ]
            },
            {
              "type": "p",
              "children": [
                "Type @, select Dex from the picker, then enter the request. Plain @Dex text does not create a Plugin binding."
              ]
            },
            {
              "type": "invocations",
              "style": "codex-plugin"
            },
            {
              "type": "h4",
              "children": [
                "Update"
              ]
            },
            {
              "type": "p",
              "children": [
                "Find Super Durable in the plugin browser marketplace manager and select Upgrade. Restart the desktop app and start a new task."
              ]
            },
            {
              "type": "h3",
              "children": [
                "Standalone Skills"
              ]
            },
            {
              "type": "p",
              "children": [
                "This path installs all three Skills together."
              ]
            },
            {
              "type": "h4",
              "children": [
                "Install"
              ]
            },
            {
              "type": "code",
              "language": "bash",
              "children": [
                "npx skills add superdurable/dex-skills --skill '*' --agent codex --global"
              ]
            },
            {
              "type": "h4",
              "children": [
                "Use"
              ]
            },
            {
              "type": "invocations",
              "style": "codex"
            },
            {
              "type": "h4",
              "children": [
                "Update"
              ]
            },
            {
              "type": "code",
              "language": "bash",
              "children": [
                "npx skills update dex-app-builder dex-sdk dex-connector-contributor --global"
              ]
            },
            {
              "type": "p",
              "children": [
                "If the installed skills CLI does not support update, rerun the installation command above."
              ]
            }
          ]
        },
        {
          "id": "codex-cli",
          "label": "Codex CLI",
          "children": [
            {
              "type": "h3",
              "children": [
                "Plugin (recommended)"
