{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "preserveSymlinks": true,
    "paths": {
      "@site/*": ["./*"],
      "@dex-web-design/*": ["../web/app/design/*"],
      "@dex-web-workspace/*": ["../web/app/workspace/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@xyflow/react": ["./node_modules/@xyflow/react"],
      "elkjs/*": ["./node_modules/elkjs/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@superdurable/flow-definition-renderer": ["./node_modules/@superdurable/flow-definition-renderer/src/index.ts"]
    }
  },
  "include": ["src/", "docusaurus.config.ts", "sidebars.ts", "reference/sidebars/"]
}
