{
  "name": "@superdurable/dex-agents",
  "version": "0.1.0",
  "description": "Durable agent sessions for Dex, shared by the Dex TypeScript agent framework adapters",
  "license": "LicenseRef-Sustainable-Use-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex.git",
    "directory": "agents/typescript/core"
  },
  "homepage": "https://github.com/superdurable/dex/tree/main/agents/typescript/core#readme",
  "bugs": {
    "url": "https://github.com/superdurable/dex/issues"
  },
  "type": "module",
  "bin": {
    "dex-agents-session-graph": "dist/src/agent-session-flow-graph-cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/index.d.ts",
      "import": "./dist/src/mcp/index.js"
    },
    "./connectors": {
      "types": "./dist/src/connectors/index.d.ts",
      "import": "./dist/src/connectors/index.js"
    },
    "./ui-stream": {
      "types": "./dist/src/ui-stream/index.d.ts",
      "import": "./dist/src/ui-stream/index.js"
    },
    "./builtin-loop": {
      "types": "./dist/src/builtin-loop/index.d.ts",
      "import": "./dist/src/builtin-loop/index.js"
    },
    "./stepwise": {
      "types": "./dist/src/stepwise/index.d.ts",
      "import": "./dist/src/stepwise/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/src/ai-sdk/index.d.ts",
      "import": "./dist/src/ai-sdk/index.js"
    },
    "./s3": {
      "types": "./dist/src/s3/index.d.ts",
      "import": "./dist/src/s3/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "npm run build && node --test --test-concurrency=1 --test-timeout=240000 'dist/test/integ/*.integration.test.js'",
    "test:long": "npm run build && node --test --test-concurrency=1 --test-timeout=1800000 'dist/test/long/*.integration.test.js'"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.3.0",
    "@superdurable/connectors-sdk": "^0.9.0 || ^0.10.0",
    "@superdurable/dex": "1.45.3",
    "ai": "^7.0.159"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@superdurable/connectors-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@superdurable/connectors-sdk": "0.9.0",
    "@superdurable/dex": "1.45.3",
    "@types/node": "22.20.5",
    "ai": "7.0.159",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
