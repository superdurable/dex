    },
    {
      "from": "launcher",
      "message": {
        "type": "response",
        "id": 1,
        "error": {
          "code": "invalid_params",
          "message": "The request has no idempotency_key."
        }
      }
    },
    {
      "from": "tui",
      "message": {
        "type": "request",
        "id": "two",
        "method": "list_connectors",
        "params": {},
        "idempotency_key": "01a1caff-706a-75b8-b6e5-42708192a3b4"
      },
      "malformed": true
    },
    {
      "from": "tui",
      "message": {
        "type": "request",
        "id": 2,
        "idempotency_key": "01a1caff-706b-75b8-b6e5-43708192a3b4",
        "method": "list_connectors",
        "params": {}
      },
      "ignore": [
        "idempotency_key"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "response",
        "id": 2,
        "result": {
          "mcp_url": "http://127.0.0.1:8803/mcp",
          "tools": [
            {
              "name": "hacker_news_list_story_ids",
              "connector": "hacker-news",
