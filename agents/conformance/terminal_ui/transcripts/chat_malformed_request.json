        "capabilities": {
          "images": {
            "max_per_message": 20,
            "max_bytes": 3750000
          },
          "plan_mode": false,
          "turn_control": true
        },
        "notices": [],
        "log_path": "~/.dex/agents/openai-sdk.log"
      },
      "ignore": [
        "command.name",
        "command.harness",
        "command.language",
        "command.version",
        "dex.server_address",
        "dex.web_url",
        "session.flow_type",
        "session.session_id",
        "display",
        "capabilities",
        "log_path",
        "connectors"
      ]
    },
    {
      "from": "tui",
      "message": {
        "type": "ready"
      }
    },
    {
      "from": "tui",
      "message": {
        "type": "request",
        "id": 1,
        "method": "list_connectors",
        "params": {}
      },
