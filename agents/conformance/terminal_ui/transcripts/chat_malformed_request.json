{
  "name": "chat_malformed_request",
  "description": "A malformed request with a usable id gets invalid_params; one without a usable id is dropped; the next request is served.",
  "real_roles": [
    "launcher"
  ],
  "terminal_ui_environment": {},
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "launch",
        "contract": 1,
        "mode": "chat",
        "command": {
          "name": "dex-agents-openai-sdk",
          "harness": "openai-sdk",
          "language": "python",
          "version": "0.7.0"
        },
        "dex": {
          "server_address": "127.0.0.1:8801",
          "tls": {
            "enabled": false,
            "ca_file": null,
            "server_name": null
          },
          "auth": {
            "mode": "none"
          },
          "web_url": "http://127.0.0.1:8802"
        },
        "session": {
          "flow_type": "DexAgentsOpenAISdkCliSession-ab12cd",
          "session_id": "openai-sdk-20261111-142233-a1b2c3",
          "is_resumed": false
        },
        "display": {
          "model": "gpt-5.2",
          "workspace": "~/dex-agent-workspace",
          "config_path": "~/.dex/agents/openai-sdk.yaml"
        },
        "methods": [
          "put_image",
          "start_session",
          "list_connectors",
          "open_url",
          "get_request_result"
