              "connection": "support-slack",
              "operation": "post_message",
              "is_enabled": false
            },
            {
              "name": "lookup",
              "connector": null,
              "connection": null,
              "operation": null,
              "is_enabled": true
            }
          ],
          "connections": [
            {
              "connector": "hacker-news",
              "connection": "default",
              "status": "authorized"
            },
            {
              "connector": "slack",
              "connection": "support-slack",
              "status": "pending"
            }
          ]
        }
      },
      "ignore": [
        "result.mcp_url",
        "result.tools",
        "result.connections"
      ]
    }
  ],
  "tui_exit": 0
}
