{
  "name": "launch_dex_setup_failed",
  "description": "DEX_CREDENTIAL_FILE names a file that cannot be read; dexcli answers dex_setup_failed.",
  "real_roles": [
    "tui"
  ],
  "terminal_ui_environment": {
    "DEX_CREDENTIAL_FILE": "/home/user/missing-token"
  },
  "later_check_failure": {
    "code": "dex_setup_failed",
    "cause": "DEX_CREDENTIAL_FILE names a token file that dexcli cannot read."
  },
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "launch",
        "contract": 1,
        "mode": "chat",
        "command": {
          "name": "dex-agents-openai-sdk",
          "harness": "openai-sdk",
          "language": "python",
          "version": "0.7.0"
        },
        "dex": {
          "server_address": "127.0.0.1:8801",
          "tls": {
            "enabled": false,
            "ca_file": null,
            "server_name": null
          },
          "auth": {
            "mode": "bearer",
            "source": "file"
          },
          "web_url": "http://127.0.0.1:8802"
        },
        "session": {
          "flow_type": "DexAgentsOpenAISdkCliSession-ab12cd",
          "session_id": "openai-sdk-20261111-142233-a1b2c3",
          "is_resumed": false
        },
        "display": {
          "model": "gpt-5.2",
          "workspace": "~/dex-agent-workspace",
          "config_path": "~/.dex/agents/openai-sdk.yaml"
        },
        "methods": [
          "put_image",
          "start_session",
          "list_connectors",
          "open_url",
          "get_request_result"
        ],
        "capabilities": {
          "images": {
            "max_per_message": 20,
            "max_bytes": 3750000
          },
          "plan_mode": false,
          "turn_control": true
        },
        "notices": [],
        "log_path": "~/.dex/agents/openai-sdk.log"
      },
      "ignore": [
        "command.name",
        "command.harness",
        "command.language",
        "command.version",
        "dex.server_address",
        "dex.web_url",
        "session.flow_type",
        "session.session_id",
        "display",
        "capabilities",
        "log_path",
        "connectors"
      ]
    },
    {
      "from": "tui",
      "message": {
        "type": "launch_rejected",
        "code": "dex_setup_failed",
        "message": "The credential that DEX_CREDENTIAL_FILE names is not usable for dex.auth mode bearer."
      }
    }
  ],
  "tui_exit": 1
}
