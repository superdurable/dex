{
  "name": "chat_put_image_cancelled_then_recovered",
  "description": "The response is lost, dexcli's wait times out: it cancels the wait, which answers cancelled, then reads the stored outcome with get_request_result.",
  "real_roles": [
    "launcher",
    "tui"
  ],
  "terminal_ui_environment": {},
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "launch",
        "contract": 1,
        "mode": "chat",
        "command": {
          "name": "dex-agents-openai-sdk",
          "harness": "openai-sdk",
          "language": "python",
          "version": "0.7.0"
        },
        "dex": {
          "server_address": "127.0.0.1:8801",
          "tls": {
            "enabled": false,
            "ca_file": null,
            "server_name": null
          },
          "auth": {
            "mode": "none"
          },
          "web_url": "http://127.0.0.1:8802"
        },
        "session": {
          "flow_type": "DexAgentsOpenAISdkCliSession-ab12cd",
          "session_id": "openai-sdk-20261111-142233-a1b2c3",
          "is_resumed": false
        },
        "display": {
          "model": "gpt-5.2",
          "workspace": "~/dex-agent-workspace",
          "config_path": "~/.dex/agents/openai-sdk.yaml"
        },
        "methods": [
          "put_image",
          "start_session",
          "list_connectors",
          "open_url",
          "get_request_result"
        ],
        "capabilities": {
          "images": {
            "max_per_message": 20,
            "max_bytes": 3750000
          },
          "plan_mode": false,
          "turn_control": true
        },
        "notices": [],
        "log_path": "~/.dex/agents/openai-sdk.log"
      },
      "ignore": [
        "command.name",
        "command.harness",
        "command.language",
        "command.version",
        "dex.server_address",
        "dex.web_url",
        "session.flow_type",
        "session.session_id",
        "display",
        "log_path"
      ]
    },
    {
      "from": "tui",
      "message": {
        "type": "ready"
      }
    },
    {
      "from": "tui",
      "message": {
        "type": "request",
        "id": 1,
        "idempotency_key": "01a1caff-6ed8-71f4-b2a9-0c3d5e6f7081",
        "method": "put_image",
        "params": {
          "path": "/home/user/pictures/screenshot.png"
        }
      },
      "ignore": [
        "idempotency_key",
        "params.path"
      ]
    },
    {
      "from": "tui",
      "message": {
        "type": "cancel",
        "id": 1
      }
    },
    {
      "from": "launcher",
      "message": {
        "type": "response",
        "id": 1,
        "error": {
          "code": "cancelled",
          "message": "Stopped waiting for put_image."
        }
      }
    },
    {
      "from": "tui",
      "message": {
        "type": "request",
        "id": 2,
        "method": "get_request_result",
        "params": {
          "idempotency_key": "01a1caff-6ed8-71f4-b2a9-0c3d5e6f7081"
        }
      }
    },
    {
      "from": "launcher",
      "message": {
        "type": "response",
        "id": 2,
        "result": {
          "state": "done",
          "result": {
            "image": {
              "type": "image",
              "uri": "file:///home/user/.dex/agents/media/sha256/b71939897603461a8a315677af1a80ff9c7c507e4c2e8ce42eefc6de6b09d54b",
              "mime_type": "image/png",
              "size_bytes": 48213,
              "sha256": "b71939897603461a8a315677af1a80ff9c7c507e4c2e8ce42eefc6de6b09d54b"
            },
            "name": "screenshot.png"
          }
        }
      }
    }
  ],
  "tui_exit": 0
}
