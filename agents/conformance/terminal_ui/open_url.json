{
  "description": "Which URLs open_url opens. Hand-written; see agents/cli/TERMINAL_UI_CONTRACT.md.",
  "rule": "Refuse a URL that contains anything but printable ASCII (U+0021 to U+007E) or contains a backslash. Otherwise split both URLs (RFC 3986). Allow only when web_url is not null; both schemes are http or https and equal without case; the authority has no userinfo and no percent sign; the host is a bracketed IPv6 address or ASCII letters, digits, dots, and hyphens, and the hosts are equal without case (no IDNA conversion); the port is absent (80 for http, 443 for https) or a decimal from 1 to 65535 without a leading zero, and the ports are equal; no path segment is . or .. (also when written with %2e); and the URL's path equals web_url's path without its trailing slashes, or starts with that path followed by /, or web_url's path is empty or /.",
  "cases": [
    {
      "description": "The base URL itself.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802",
      "is_allowed": true
    },
    {
      "description": "The root path.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802/",
      "is_allowed": true
    },
    {
      "description": "A path, query, and fragment.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802/v2/flows/openai-sdk-20261111-142233-a1b2c3?tab=session#top",
      "is_allowed": true
    },
    {
      "description": "Scheme and host compare without case.",
      "web_url": "http://127.0.0.1:8802",
      "url": "HTTP://127.0.0.1:8802/v2",
      "is_allowed": true
    },
    {
      "description": "The default port equals an explicit one.",
      "web_url": "http://localhost:80",
      "url": "http://LOCALHOST/v2",
      "is_allowed": true
    },
    {
      "description": "Under a base path.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/v2/flows",
      "is_allowed": true
    },
    {
      "description": "A trailing slash on the base does not matter.",
      "web_url": "https://dex.example.com/web/",
      "url": "https://dex.example.com/web",
      "is_allowed": true
    },
    {
      "description": "The base path must end at a segment boundary.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/webhooks",
      "is_allowed": false
    },
    {
      "description": "Outside the base path.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/",
      "is_allowed": false
    },
    {
      "description": "A dot segment.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/../admin",
      "is_allowed": false
    },
    {
      "description": "A percent-encoded dot segment.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/%2e%2E/admin",
      "is_allowed": false
    },
    {
      "description": "Another host that starts with the base host.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802.evil.example/",
      "is_allowed": false
    },
    {
      "description": "Userinfo: the host is evil.example.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802@evil.example/",
      "is_allowed": false
    },
    {
      "description": "Userinfo is refused even for the right host.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://user@127.0.0.1:8802/",
      "is_allowed": false
    },
    {
      "description": "Another port.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8803/",
      "is_allowed": false
    },
    {
      "description": "Another scheme.",
      "web_url": "http://127.0.0.1:8802",
      "url": "https://127.0.0.1:8802/",
      "is_allowed": false
    },
    {
      "description": "A backslash.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802\\@evil.example/",
      "is_allowed": false
    },
    {
      "description": "A space.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802/ x",
      "is_allowed": false
    },
    {
      "description": "A control character.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802/\tx",
      "is_allowed": false
    },
    {
      "description": "Not http or https.",
      "web_url": "http://127.0.0.1:8802",
      "url": "javascript:alert(1)",
      "is_allowed": false
    },
    {
      "description": "A file URL.",
      "web_url": "http://127.0.0.1:8802",
      "url": "file:///home/user/.ssh/id_ed25519",
      "is_allowed": false
    },
    {
      "description": "No scheme.",
      "web_url": "http://127.0.0.1:8802",
      "url": "//127.0.0.1:8802/",
      "is_allowed": false
    },
    {
      "description": "No web_url in the launch document.",
      "web_url": null,
      "url": "http://127.0.0.1:8802/",
      "is_allowed": false
    },
    {
      "description": "A port over 65535.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:99999/",
      "is_allowed": false
    },
    {
      "description": "A port with a leading zero.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:08802/",
      "is_allowed": false
    },
    {
      "description": "An empty port.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:/",
      "is_allowed": false
    },
    {
      "description": "A port that is not a number.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:88o2/",
      "is_allowed": false
    },
    {
      "description": "An explicit default port.",
      "web_url": "http://localhost",
      "url": "http://localhost:80/",
      "is_allowed": true
    },
    {
      "description": "Port 0.",
      "web_url": "http://localhost",
      "url": "http://localhost:0/",
      "is_allowed": false
    },
    {
      "description": "An IPv6 host.",
      "web_url": "http://[::1]:8802",
      "url": "http://[::1]:8802/v2",
      "is_allowed": true
    },
    {
      "description": "Another IPv6 host.",
      "web_url": "http://[::1]:8802",
      "url": "http://[::2]:8802/v2",
      "is_allowed": false
    },
    {
      "description": "A Cyrillic letter in the host: only printable ASCII is allowed.",
      "web_url": "https://dex.example.com",
      "url": "https://dеx.example.com/",
      "is_allowed": false
    },
    {
      "description": "The Unicode form of the base's IDNA host is not converted, so it is refused.",
      "web_url": "https://xn--bcher-kva.example",
      "url": "https://bücher.example/",
      "is_allowed": false
    },
    {
      "description": "The IDNA host, compared without case.",
      "web_url": "https://xn--bcher-kva.example",
      "url": "https://XN--BCHER-KVA.example/v2",
      "is_allowed": true
    },
    {
      "description": "A percent sign in the authority.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1%3a8802/",
      "is_allowed": false
    },
    {
      "description": "A non-ASCII path: the terminal UI percent-encodes paths.",
      "web_url": "http://127.0.0.1:8802",
      "url": "http://127.0.0.1:8802/v2/日本",
      "is_allowed": false
    },
    {
      "description": "An encoded slash does not end the base path segment.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web%2f..%2fadmin",
      "is_allowed": false
    },
    {
      "description": "A dot segment, half encoded.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/.%2E/admin",
      "is_allowed": false
    },
    {
      "description": "A doubly encoded dot segment is a plain name.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/%252e%252e/admin",
      "is_allowed": true
    },
    {
      "description": "A stray percent sign in the path passes through.",
      "web_url": "https://dex.example.com/web",
      "url": "https://dex.example.com/web/%zz",
      "is_allowed": true
    }
  ]
}
