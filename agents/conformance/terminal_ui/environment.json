        "ANTHROPIC_API_KEY": "test-anthropic-key-not-a-secret",
        "AWS_SECRET_ACCESS_KEY": "test-aws-secret-not-a-secret",
        "DEX_TOKEN_URL": "https://auth.example.com/oauth/token",
        "DEX_SERVER_ID": "orders-production",
        "DEX_TLS": "true",
        "DEX_TLS_CA_FILE": "/home/user/ca.pem",
        "DISPLAY": ":0",
        "BROWSER": "firefox",
        "DEX_CREDENTIAL": ""
      },
      "terminal_ui_environment": {
        "HOME": "/home/user",
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "LANG": "en_US.UTF-8",
        "DEX_CREDENTIAL": ""
      },
      "missing_auth_variable": "DEX_CREDENTIAL"
    }
  ]
}
