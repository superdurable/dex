              "turn_control"
            ]
          },
          "2": {
            "modes": {
              "chat": {
                "uses_methods": [
                  "put_image"
                ]
              }
            },
            "capabilities": [
              "images"
            ]
          }
        },
        "build": "x"
      },
      "mode": "chat",
      "expected": {
        "contract": 2
