    {
      "name": "highest-common-with-the-mode",
      "description": "Contract 2 lacks sessions, so sessions runs on 1.",
      "launcher_contracts": [
        1,
        2
      ],
      "describe": {
        "dexcli_version": "1.60.0",
        "contracts": {
          "1": {
            "modes": {
              "chat": {
                "uses_methods": [
                  "put_image",
                  "start_session",
                  "list_connectors",
                  "open_url",
                  "get_request_result"
                ]
              },
              "sessions": {
                "uses_methods": []
              },
              "connectors": {
                "uses_methods": [
                  "list_connectors",
                  "open_url"
                ]
              }
            },
            "capabilities": [
              "images",
              "plan_mode",
              "turn_control"
            ]
          },
          "2": {
            "modes": {
              "chat": {
                "uses_methods": [
                  "put_image"
