  "built_in_tool_definitions": [
    {
      "name": "ask_user",
      "description": "Ask the user one question and wait for the answer, which becomes this tool's result. Use it only when you cannot continue without information or a decision from the user. The wait can last hours or days.",
      "parameters_json": "{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"description\":\"One concise question for the user.\"},\"choices\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Answers the user can pick. Omit for a free-text answer.\"},\"allows_free_text\":{\"type\":\"boolean\",\"description\":\"Whether the user may answer with text that is not one of the choices. Defaults to true.\"}},\"required\":[\"question\"],\"additionalProperties\":false}"
    },
    {
      "name": "durable_wait",
      "description": "Pause this turn for a number of whole seconds, then continue. Nothing runs during the wait. Use it to wait for something outside the conversation, such as a job that needs time to finish.",
      "parameters_json": "{\"type\":\"object\",\"properties\":{\"duration_seconds\":{\"type\":\"integer\",\"minimum\":1,\"description\":\"Whole seconds to wait.\"},\"reason\":{\"type\":\"string\",\"description\":\"Why the turn waits, shown to the user.\"}},\"required\":[\"duration_seconds\",\"reason\"],\"additionalProperties\":false}"
    },
    {
      "name": "write_todos",
      "description": "Replace the plan with a complete, ordered list of tasks. Send every task each time, with its status. An empty list clears the plan. Keep the statuses current: mark a task in_progress when you start it and completed when it is done.",
      "parameters_json": "{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"description\":\"Every task of the plan, in order.\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\",\"description\":\"What the task does, in one short sentence.\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\"],\"description\":\"Where the task stands.\"}},\"required\":[\"content\",\"status\"],\"additionalProperties\":false}}},\"required\":[\"todos\"],\"additionalProperties\":false}"
    }
  ],
