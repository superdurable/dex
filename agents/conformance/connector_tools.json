      "violation": null
    },
    {
      "arguments": {
        "accountId": "a",
        "amount": 5,
        "lines": [
          {
            "sku": "s",
            "count": "1"
          }
        ]
      },
      "violation": "arguments.lines[0].count must be integer or null"
    },
    {
      "arguments": {
        "accountId": "a",
        "amount": 5,
        "note": null
