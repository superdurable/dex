{
  "description": "Connector tool behavior every core must match: argument checks, branch mapping, result text, truncation, and default tool names. Hand-written; see README.md.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accountId": {
        "type": "string",
        "description": "The account."
      },
      "amount": {
        "type": "integer",
        "minimum": 1
      },
      "reason": {
        "type": "string",
        "enum": [
          "duplicate",
          "fraudulent"
        ]
      },
      "metadata": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "lines": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Line"
        }
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "accountId",
      "amount"
    ],
    "$defs": {
      "Line": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string"
          },
          "count": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "sku"
        ]
      }
    }
  },
