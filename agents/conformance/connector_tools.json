  "boundedResendScenarios": {
    "description": "Attempts of one sendMessage call, each run by a Worker whose manifest and definition follow the named variant. cap3 and cap5 declare repeatOnUnknown limited with that cap in both; fallback keeps the definition at cap 3 but drops repeatOnUnknown and maxSends from the manifest. The call is deferred by deferVariant with the tool policy's maxSends, if any. Each attempt ends in retry (the connector asked to retry), succeeded, failed, or outcome_unknown. writes counts the messages the provider stored.",
    "cases": [
      {
        "name": "a connector upgraded from cap 3 to cap 5 keeps the call's cap 3",
        "text": "lose-always",
        "deferVariant": "cap3",
        "policyMaxSends": null,
        "reference": "{\"tool\": \"send\", \"maxSends\": 3}",
        "attemptVariants": [
          "cap3",
          "cap3",
          "cap3",
          "cap5"
        ],
        "outcomes": [
          "retry",
          "retry",
          "retry",
          "outcome_unknown"
        ],
        "writes": 3
      },
      {
        "name": "a connector downgraded from cap 5 to cap 3 keeps the call's cap 5",
        "text": "lose-always",
        "deferVariant": "cap5",
        "policyMaxSends": null,
        "reference": "{\"tool\": \"send\", \"maxSends\": 5}",
