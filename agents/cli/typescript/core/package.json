{
  "name": "@superdurable/dex-agents-cli-core",
  "version": "0.1.0",
  "description": "Shared core of the Dex Agents CLI commands: configuration, the local Dex server, connectors, local tools, and the terminal chat",
  "license": "LicenseRef-Sustainable-Use-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex.git",
    "directory": "agents/cli/typescript/core"
  },
  "homepage": "https://github.com/superdurable/dex/tree/main/agents/cli/typescript/core#readme",
  "bugs": {
    "url": "https://github.com/superdurable/dex/issues"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "dist/src",
    "dist/schemas",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/copy-schemas.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=300000 'dist/test/conformance/*.test.js' 'dist/test/integ/*.integration.test.js'",
    "test:conformance": "npm run build && node --test 'dist/test/conformance/*.test.js'",
    "test:integration": "npm run build && node --test --test-concurrency=1 --test-timeout=300000 'dist/test/integ/*.integration.test.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1",
    "playwright-core": "1.56.1",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@superdurable/dex": "1.45.2",
    "@superdurable/dex-agents": "^0.1.0"
  },
  "devDependencies": {
    "@superdurable/dex": "1.45.2",
    "@superdurable/dex-agents": "file:../../../typescript/core",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
