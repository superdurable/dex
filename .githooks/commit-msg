#!/bin/sh
# Strip Cursor trailers and reject any other agent attribution. Agents must not skip this hook.
set -e

message_file=$1
if [ ! -f "$message_file" ]; then
  echo "commit-msg: missing commit message file" >&2
  exit 1
fi

filtered=$(mktemp)
trap 'rm -f "$filtered"' EXIT
if ! grep -Eiv \
  '^[[:space:]]*Co-authored-by:.*cursor|^[[:space:]]*Made-with:[[:space:]]*Cursor\b|cursoragent@cursor\.com' \
  "$message_file" > "$filtered"; then
  :
fi
cat "$filtered" > "$message_file"

# Keep this pattern in sync with script/check-commit-attribution, which CI runs.
agent_pattern='^[[:space:]]*Co-authored-by:.*(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor)|noreply@anthropic\.com|cursoragent@cursor\.com|Generated with \[?Claude Code|^[[:space:]]*Made-with:[[:space:]]*Cursor'
if matches=$(grep -Ein "$agent_pattern" "$message_file"); then
  echo "commit-msg: agent attribution is not allowed:" >&2
  echo "$matches" >&2
  exit 1
fi
