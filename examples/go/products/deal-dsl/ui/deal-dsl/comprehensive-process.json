{
  "processID": "comprehensive-deal-dsl",
  "itemID": "item-42",
  "itemName": "Premium research package",
  "initialState": "buyer-negotiation",
  "initialStateData": {
    "acceptedProposedPrice": "false",
    "proceedWithItem": "false",
    "proposedItemPrice": "",
    "proposedItemSamplePrice": "",
    "proposedItemSampleRefund": ""
  },
  "states": [
    {
      "name": "buyer-negotiation",
      "postCondition": {
        "waitFor": {"name": "buyer-proposal"},
        "decision": {"elseState": "seller-counteroffer"}
      }
    },
    {
      "name": "seller-counteroffer",
      "preCondition": {"name": "seller-price-response"},
      "postCondition": {
        "decision": {
          "key": "acceptedProposedPrice",
          "cases": [
            {"equals": "true", "goToState": "process-item-sample"}
          ],
          "elseState": "buyer-negotiation"
        }
      }
    },
    {
      "name": "process-item-sample",
      "preActions": ["transferMoneyFromBuyerToSeller"],
      "postActions": ["deliverItemSampleToBuyer"],
      "postCondition": {
        "decision": {"elseState": "wait-item-sample-feedback"}
      }
    },
    {
      "name": "wait-item-sample-feedback",
      "preCondition": {"name": "item-sample-feedback"},
      "postCondition": {
        "decision": {
          "key": "proceedWithItem",
          "cases": [
            {"equals": "true", "goToState": "process-item-order"}
          ],
          "elseState": "process-refund"
        }
      }
    },
    {
      "name": "process-item-order",
      "preActions": ["transferMoneyFromBuyerToSeller"],
      "postActions": ["deliverItemToBuyer"]
    },
    {
      "name": "process-refund",
      "preActions": ["transferMoneyFromSellerToBuyer"]
    }
  ]
}
