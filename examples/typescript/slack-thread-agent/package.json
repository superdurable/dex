{
  "name": "@superdurable/dex-example-slack-thread-agent",
  "private": true,
  "version": "0.0.0",
  "description": "An agent session that Slack Connector Triggers start and feed: one session per thread",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
