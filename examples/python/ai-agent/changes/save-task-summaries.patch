+def _summarize_tool_result(result: ToolExecutionResult) -> str:
+    try:
+        content = json.loads(result.content).get("content", [])
+        text = " ".join(item.get("text", "") for item in content) or result.content
+    except (AttributeError, TypeError, ValueError):
+        text = result.content
+    outcome = "Failed" if result.is_error else "Done"
+    return f"{outcome}: {text[:200]}"
+
